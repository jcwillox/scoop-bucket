    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.9.1/vortex-setup-2.9.1.exe#/dl.7z",
            "hash": "sha512:93049d127f8d71c43645c203a003d2b87ffcefaa3a74f2506c6852734f259415e02d0fc0d376e68f7a9e5eb7750e5c326d35a2c4e0ed77f911591087d9dcf7c3",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
