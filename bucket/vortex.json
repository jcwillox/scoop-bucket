    "homepage": "https://www.nexusmods.com/about/vortex",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.4.1/vortex-setup-2.4.1.exe#/dl.7z",
            "hash": "sha512:2b10dee382e5a45e6a589ae036d9b955fce938d1f51fb383e731e7d60eb87972266939d636c67a41285dd8e1cb396d90f83b6491df1d9a90a9ed6478a82e196d",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
