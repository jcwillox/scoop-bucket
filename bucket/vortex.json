    "architecture": {
        "64bit": {
            "url": "https://github.com/Nexus-Mods/Vortex/releases/download/v2.7.1/vortex-setup-2.7.1.exe#/dl.7z",
            "hash": "sha512:f23162c1775dcc438178847c2e3763c98d1ae92e84cea995cb43e3ba546f09fc9d11d30532ed99ead958f7967219e558dbf8534126764f5bb7860e2b9c1dca7d",
            "pre_install": [
